{
  "name": "server",
  "version": "0.0.0",
  "description": "Backend for happy-go-lucky",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext .ts,.js --exec \"npm run build && node dist/server.js\"",
    "build": "tsc",
    "test": "vitest run --reporter=verbose",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.7",
    "supertest": "^7.1.4",
    "vitest": "^5.0.5"
  }
}
